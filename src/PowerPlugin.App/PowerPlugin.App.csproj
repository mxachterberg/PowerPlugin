<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>PowerPlugin.App</RootNamespace>
    <AssemblyName>PowerPlugin</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PowerPlugin.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      The sensor library ships its implementation only under runtimes/<rid>/, so a build without
      a runtime identifier copies nothing and the application fails to start. Naming the
      identifier here makes a plain "dotnet build" produce a runnable output; pass
      -r win-arm64 to override it.
    -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <Description>Live power consumption monitor for Windows 11 with tray indicator and energy statistics.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      References WPF, Windows Forms (NotifyIcon) and GDI+ without pulling in the
      Microsoft.NET.Sdk.WindowsDesktop MSBuild SDK, which keeps the project
      restorable and compilable on non-Windows build agents.
    -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the window and the tray fallback can load it without a file on disk. -->
    <EmbeddedResource Include="Assets\PowerPlugin.ico" LogicalName="PowerPlugin.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerPlugin.Core\PowerPlugin.Core.csproj" />
    <ProjectReference Include="..\PowerPlugin.Windows\PowerPlugin.Windows.csproj" />
  </ItemGroup>

</Project>
